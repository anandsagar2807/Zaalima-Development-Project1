# CreditSense - Environment Configuration
# Copy this file to .env and update the values for your environment

# ===== NODE ENVIRONMENT =====
NODE_ENV=development
PORT=5000

# ===== JWT CONFIGURATION =====
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h

# ===== DATABASE CONFIGURATION =====
# PostgreSQL (Prisma ORM)
DATABASE_URL=postgresql://postgres:password@localhost:5432/credit_decision?schema=public

# MongoDB (for document extractions, intelligence, explanations)
MONGODB_URI=mongodb://localhost:27017/credit_decision

# ===== FILE UPLOAD CONFIGURATION =====
# Local file upload directory
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes

# S3 Configuration (optional, for production)
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== FRONTEND CONFIGURATION =====
# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# ===== EXTERNAL API INTEGRATIONS =====
# Optional: Add third-party API keys here as needed
# - MCA API: https://active.mca.gov.in/
# - Google Vision API for document OCR
# - News APIs (NewsAPI, Bing News, etc.)
OCR_PROVIDER=local
CIBIL_API_URL=https://api.cibil.com
CIBIL_API_KEY=your-cibil-api-key
MCA_API_URL=https://api.mca.gov.in
E_COURTS_API_URL=https://api.ecourts.gov.in
NEWS_API_URL=https://newsapi.org
NEWS_API_KEY=

# ===== LOGGING CONFIGURATION =====
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000

# ===== MAIL CONFIGURATION (optional) =====
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ===== CACHE CONFIGURATION (optional) =====
REDIS_URL=redis://localhost:6379

# ===== SECURITY =====
CORS_ORIGIN=http://localhost:3000
HELMET_ENABLED=true
HELMET_CONTENT_SECURITY_POLICY=true
