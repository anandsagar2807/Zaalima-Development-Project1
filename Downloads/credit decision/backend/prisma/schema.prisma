// PostgreSQL Schema - Structured Data
// Using Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Application/Company Master
model Company {
  id                String              @id @default(cuid())
  name              String
  cin               String?             @unique
  pan               String?             @unique
  gstin             String?             @unique
  incorporationDate DateTime?
  businessType      String?
  sector            String?
  scale             CompanyScale        @default(SME)
  status            CompanyStatus       @default(ACTIVE)
  
  // Contact Information
  address           String?
  city              String?
  state             String?
  pincode           String?
  email             String?
  phone             String?
  
  // Application Tracking
  applications      Application[]
  documents         Document[]
  litigations       Litigation[]
  researchData      ResearchData[]
  gstAnalysis       GSTAnalysis[]
  
  // Scoring
  cibilScore        Float?
  internalRating    String?
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

enum CompanyScale {
  SME
  MID_CORPORATE
  LARGE_CORPORATE
}

enum CompanyStatus {
  ACTIVE
  DEFAULTER
  NCLT
  WINDING_UP
}

// Credit Application
model Application {
  id                  String              @id @default(cuid())
  applicationNumber   String              @unique
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id])
  
  // Loan Details
  loanAmount          Float
  tenorMonths         Int
  purpose             String?
  
  // Status Tracking
  status              ApplicationStatus   @default(PENDING)
  stage               ApplicationStage    @default(DOCUMENT_UPLOAD)
  
  // Financial Data
  annualTurnover      Float?
  profitAfterTax      Float?
  netWorth            Float?
  totalDebt           Float?
  
  // Scoring Results
  finalScore          Float?
  riskGrade           String?
  recommendedAmount   Float?
  riskPremium         Float?
  
  // Relationships
  documents           Document[]
  scores              CreditScore[]
  primaryInput        PrimaryInput?
  litigationRecords   Litigation[]
  researchData        ResearchData[]
  gstAnalysis         GSTAnalysis[]
  cam                 CAM?
  
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  submittedAt         DateTime?
  decisionDate        DateTime?
}

enum ApplicationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  ON_HOLD
}

enum ApplicationStage {
  DOCUMENT_UPLOAD
  VERIFICATION
  SCORING
  PRIMARY_INPUT
  APPROVAL_PENDING
  COMPLETED
}

// Document Management
model Document {
  id              String          @id @default(cuid())
  applicationId   String
  application     Application     @relation(fields: [applicationId], references: [id])
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  
  // Document Metadata
  name            String
  type            DocumentType
  mimeType        String
  filename        String
  s3Key           String
  size            Int
  
  // Processing Status
  status          DocumentStatus  @default(UPLOADED)
  ocrText         String?
  
  // Extracted Data (stored in MongoDB, reference here)
  extractionId    String?
  
  // Validation Flags
  isAuthentic     Boolean?
  validationScore Float?
  
  uploadedAt      DateTime        @default(now())
  processedAt     DateTime?
}

enum DocumentType {
  GST_RETURN_1
  GST_RETURN_3B
  GST_2A
  ITR
  BANK_STATEMENT
  BALANCE_SHEET
  PNL_STATEMENT
  ANNUAL_REPORT
  BOARD_RESOLUTION
  CIBIL_REPORT
  MOA_AOA
  RATING_REPORT
  SHAREHOLDING_PATTERN
  SITE_VISIT_REPORT
  MANAGEMENT_INTERVIEW
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PARSED
  VALIDATED
  FLAGGED
  REJECTED
}

// Primary Input from Credit Officer
model PrimaryInput {
  id              String          @id @default(cuid())
  applicationId   String          @unique
  application     Application     @relation(fields: [applicationId], references: [id])
  
  // Site Visit Observations
  siteVisitDate   DateTime?
  capacityUtilization Float?
  inventoryQuality    String?
  employeeMorale      String?
  
  // Management Assessment
  managementExperience    Int?
  managementQuality       Int?
  promoterCredibility     Int?
  successionPlanning      String?
  
  // Risk Observations
  keyRisks           String?
  mitigationFactors  String?
  
  // Adjustments
  scoreAdjustment    Float?
  adjustmentReason   String?
  
  officerId      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// Credit Scoring - Five Cs Framework
model CreditScore {
  id              String          @id @default(cuid())
  applicationId   String
  application     Application     @relation(fields: [applicationId], references: [id])
  
  // Five Cs Scores
  characterScore      Float
  capacityScore       Float
  capitalScore        Float
  collateralScore     Float
  conditionsScore     Float
  
  // Subscores
  financialRatioScore     Float?
  gstAnalysisScore        Float?
  bankStatementScore      Float?
  litigationImpact        Float?
  sectorRiskImpact        Float?
  
  // Final Score
  totalScore          Float
  weightedScore       Float
  riskGrade           String
  
  // Explainability
  positiveFactors     Json
  negativeFactors     Json
  
  // Sensitivity
  sensitivityAnalysis Json
  
  calculatedAt    DateTime        @default(now())
}

// Litigation Tracking
model Litigation {
  id              String          @id @default(cuid())
  applicationId   String
  application     Application     @relation(fields: [applicationId], references: [id])
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  
  // Litigation Details
  caseNumber      String
  court           String?
  caseType        LitigationType
  petitioner      String?
  respondent      String?
  
  // Financial Impact
  claimAmount     Float?
  disputedAmount  Float?
  
  // Status
  status          String?
  filingDate      DateTime?
  lastHearing     DateTime?
  
  // Risk Assessment
  severity        LitigationSeverity
  estimatedResolutionDate DateTime?
  
  createdAt       DateTime        @default(now())
  source          String?
}

enum LitigationType {
  RECOVERY_SUIT
  CHEQUE_BOUNCE
  INSOLVENCY
  TAX_DISPUTE
  CONTRACT_DISPUTE
  LABOUR_DISPUTE
  CRIMINAL
  CIVIL
}

enum LitigationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Web Research Data
model ResearchData {
  id              String          @id @default(cuid())
  applicationId   String
  application     Application     @relation(fields: [applicationId], references: [id])
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  
  // Research Source
  sourceType      ResearchSource
  sourceUrl       String?
  
  // Content
  title           String?
  content         String
  publishedDate   DateTime?
  
  // Analysis
  sentiment       String?
  keywords        String[]
  riskIndicators  String[]
  
  createdAt       DateTime        @default(now())
}

enum ResearchSource {
  NEWS
  MCA_FILING
  RBI_REGULATION
  SECTOR_REPORT
  SOCIAL_MEDIA
}

// CAM Document
model CAM {
  id              String          @id @default(cuid())
  applicationId   String          @unique
  application     Application     @relation(fields: [applicationId], references: [id])
  
  // CAM Content
  executiveSummary    String
  industryAnalysis    String
  financialAnalysis   String
  riskAssessment      String
  recommendation      String
  
  // Metadata
  version         String          @default("1.0")
  status          CAMStatus       @default(DRAFT)
  
  // Files
  pdfUrl          String?
  docxUrl         String?
  
  generatedAt     DateTime        @default(now())
  approvedAt      DateTime?
  approvedBy      String?
}

enum CAMStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// GST Analysis Data
model GSTAnalysis {
  id                  String          @id @default(cuid())
  applicationId       String
  application         Application     @relation(fields: [applicationId], references: [id])
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id])
  
  // Reconciliation Metrics
  gstr1Turnover       Float
  gstr3bTaxPaid       Float
  gstr2aPurchase      Float
  declaredTurnover    Float
  bankTurnover        Float?
  
  // Mismatch Analysis
  turnoverVariance    Float
  taxPaymentVariance  Float
  mismatchPercentage  Float
  circularTradingFlag Boolean         @default(false)
  
  // Risk Indicators
  highRiskSuppliers   Json
  suspiciousInvoices  Int
  
  analyzedAt      DateTime        @default(now())
}

// User Management
model User {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String
  role            UserRole
  passwordHash    String
  
  // Profile
  department      String?
  designation     String?
  
  createdAt       DateTime        @default(now())
  lastLoginAt     DateTime?
  isActive        Boolean         @default(true)
}

enum UserRole {
  CREDIT_OFFICER
  RISK_ANALYST
  APPROVAL_AUTHORITY
  ADMIN
}