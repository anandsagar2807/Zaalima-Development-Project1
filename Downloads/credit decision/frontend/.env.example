# Aurora Credit OS - Frontend Environment Variables
# Copy this file to .env.local and update values

# API Configuration
# Backend API endpoint - must match backend PORT setting
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Application Configuration
NEXT_PUBLIC_APP_NAME=Aurora Credit OS
NEXT_PUBLIC_APP_DESCRIPTION=AI-powered credit decisioning platform for BFSI

# Authentication
NEXT_PUBLIC_AUTH_REQUIRED=true

# Theme
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# Analytics (Optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_GA_ID=

# Feature Flags (Optional)
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false
