PORT=4000

# GitHub App / OAuth
GITHUB_TOKEN=ghp_your_github_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/connect-github/callback

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/gitguard_ai

# LLM (OpenAI-compatible)
LLM_API_KEY=sk-your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000
LLM_MAX_DIFF_SIZE=50000
