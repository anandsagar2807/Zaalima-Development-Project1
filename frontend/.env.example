# API Base URL (backend server)
# Local dev:  http://localhost:4000
# Production: https://gitgaurd-ai.onrender.com
NEXT_PUBLIC_API_URL=https://gitgaurd-ai.onrender.com

# Clerk Authentication
# Get your keys at https://dashboard.clerk.com/last-active?path=api-keys
# Replace the placeholders below with your actual Clerk keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# App Configuration
NEXT_PUBLIC_APP_NAME=GitGuard AI
NEXT_PUBLIC_APP_ENV=production

# GitHub OAuth
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_TOKEN=your_github_personal_access_token

# IMPORTANT — GitHub OAuth App "Authorization callback URL" setting
# The ACTIVE OAuth flow runs entirely on the Render backend:
#   Vercel /api/connect-github  ->  Render /api/auth/github  ->  GitHub
#   GitHub  ->  Render /api/auth/github/callback  ->  Vercel /dashboard
# So the GitHub OAuth App callback URL MUST be the RENDER backend URL:
#   https://gitgaurd-ai.onrender.com/api/auth/github/callback
# (Do NOT use the Vercel /api/connect-github/callback URL — that flow is unused.)
GITHUB_OAUTH_REDIRECT_URI=https://gitgaurd-ai.onrender.com/api/auth/github/callback

# Database (PostgreSQL — used by insforge-server.ts for optional DB persistence)
# Get this from Render dashboard → your PostgreSQL service → "External Database URL"
DATABASE_URL=postgresql://user:password@host:port/dbname
